CREATE view contatos as

select 
	v.marca,
	v.modelo,
	v.placa,
	c.nome as clientes,
	c.telefone

FROM veiculos v 

inner join clientes c on v.cliente_id = c.id

order by v.marca asc, v.modelo asc

create view servicos as

select 
	os.id as ordem_servico,
	v.placa as veiculos,
	v.modelo,
	os.data_abertura,
	m.nome as mecanicos,
	os.status

from ordem_servico os

inner join veiculos v on os.veiculo_id = v.id
inner join clientes c on v.cliente_id = c.id
inner join mecanicos m on os.mecanico_id = m.id

	where c.nome = 'Fernanda Lima'
	order by os.data_abertura desc;

create view valor_total_os as

    select 
	os.id as ordem_servico,
	v.placa as veiculos,
	m.nome as mecanicos,
	os.valor_mao_obra,
	COALESCE(sum(p.quantidade * valor_unitario),0.00) as valor_total,
	(os.valor_mao_obra + coalesce(sum(p.quantidade * valor_unitario),0.00)) as valor_total_os
from ordem_servico os
	inner join veiculos v on os.veiculo_id = v.id
	inner join mecanicos m on os.mecanico_id = m.id
	left join peca_os p on os.id = p.os_id
	group by os.id,v.placa,m.nome,os.valor_mao_obra
	order by os.id;

CREATE view valor_maior_noventa as

select 
	nome as mecanicos,
	especialidade,
	valor_hora
from mecanicos
where valor_hora > 90
order by valor_hora desc;

create view vw_faturamento_mao_obra as

SELECT 
    m.especialidade,
    COUNT(os.id) AS qtd_servicos_concluidos,
    COALESCE(SUM(os.valor_mao_obra), 0.00) AS faturamento_mao_obra
FROM mecanicos m
LEFT JOIN ordem_servico os ON m.id = os.mecanico_id AND os.status = 'Concluida'
GROUP BY m.especialidade
ORDER BY faturamento_mao_obra DESC;
